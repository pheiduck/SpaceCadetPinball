@@ -218,6 +220,33 @@ endif()
 
 target_link_libraries(SpaceCadetPinball ${SDL2_LIBRARY} ${SDL2_MIXER_LIBRARY})
 
+# Linux only: link a General MIDI SoundFont into the executable (adds its size to the binary).
+#   cmake -DEMBED_SOUNDFONT=ON [-DSF2_FILE=/path/to/FluidR3_GM.sf2] .
+option(EMBED_SOUNDFONT "Embed a SoundFont (.sf2) in the executable (Linux)" OFF)
+set(SF2_FILE "" CACHE FILEPATH "SoundFont to embed; auto-detected if empty")
+if(EMBED_SOUNDFONT)
+    if(NOT UNIX OR APPLE)
+        message(FATAL_ERROR "EMBED_SOUNDFONT is only supported on Linux")
+    endif()
+    set(_sf2 "${SF2_FILE}")
+    if(NOT _sf2)
+        foreach(_cand /usr/share/sounds/sf2/FluidR3_GM.sf2 /usr/share/soundfonts/FluidR3_GM.sf2)
+            if(EXISTS "${_cand}")
+                set(_sf2 "${_cand}")
+                break()
+            endif()
+        endforeach()
+    endif()
+    if(NOT _sf2 OR NOT EXISTS "${_sf2}")
+        message(FATAL_ERROR "EMBED_SOUNDFONT=ON but no SoundFont found; install fluid-soundfont-gm or pass -DSF2_FILE=...")
+    endif()
+    get_filename_component(_sf2 "${_sf2}" REALPATH)
+    message(STATUS "Embedding SoundFont: ${_sf2}")
+    set_source_files_properties(SpaceCadetPinball/EmbeddedSoundFont.cpp PROPERTIES
+        COMPILE_DEFINITIONS "SF2_EMBEDDED_PATH=\"${_sf2}\""
+        OBJECT_DEPENDS "${_sf2}")
+endif()
+
 # On Windows, copy DLL to output
 if(WIN32)
     list(GET SDL2_LIBRARY -1 SDL2_DLL_PATH)
diff --git a/SpaceCadetPinball/EmbeddedSoundFont.cpp b/SpaceCadetPinball/EmbeddedSoundFont.cpp
new file mode 100644
index 0000000..28484f8
--- /dev/null
+++ b/SpaceCadetPinball/EmbeddedSoundFont.cpp
@@ -0,0 +1,65 @@
+#include "EmbeddedSoundFont.h"
+
+#if defined(__linux__) && defined(SF2_EMBEDDED_PATH)
+
+#include <sys/mman.h>
+#include <unistd.h>
+#include <cstddef>
+#include <cstdio>
+
+// Pull the .sf2 into .rodata at assembly time. SF2_EMBEDDED_PATH is an absolute
+// path supplied by CMake.
+__asm__(
+	".section .rodata\n"
+	".global pb_sf2_start\n"
+	".global pb_sf2_end\n"
+	".balign 16\n"
+	"pb_sf2_start:\n"
+	".incbin \"" SF2_EMBEDDED_PATH "\"\n"
+	"pb_sf2_end:\n"
+	".byte 0\n"
+	".previous\n");
+
+extern "C" const unsigned char pb_sf2_start[];
+extern "C" const unsigned char pb_sf2_end[];
+
+const char* EmbeddedSoundFont_GetPath()
+{
+	static char path[64];
+	static bool tried = false;
+	if (tried)
+		return path[0] ? path : nullptr;
+	tried = true;
+
+	// The descriptor is intentionally never closed: SDL_mixer re-opens the path
+	// every time MIDI playback starts.
+	int fd = memfd_create("FluidR3_GM.sf2", 0);
+	if (fd < 0)
+		return nullptr;
+
+	const unsigned char* p = pb_sf2_start;
+	size_t left = static_cast<size_t>(pb_sf2_end - pb_sf2_start);
+	while (left > 0)
+	{
+		ssize_t written = write(fd, p, left);
+		if (written <= 0)
+		{
+			close(fd);
+			return nullptr;
+		}
+		p += written;
+		left -= static_cast<size_t>(written);
+	}
+
+	snprintf(path, sizeof path, "/proc/self/fd/%d", fd);
+	return path;
+}
+
+#else
+
+const char* EmbeddedSoundFont_GetPath()
+{
+	return nullptr;
+}
+
+#endif
diff --git a/SpaceCadetPinball/EmbeddedSoundFont.h b/SpaceCadetPinball/EmbeddedSoundFont.h
new file mode 100644
index 0000000..c783ad9
--- /dev/null
+++ b/SpaceCadetPinball/EmbeddedSoundFont.h
@@ -0,0 +1,9 @@
+#pragma once
+
+// Optional SoundFont linked into the executable (Linux, -DEMBED_SOUNDFONT=ON).
+// SDL_mixer's FluidSynth backend can only load SoundFonts by file path, so the
+// embedded data is exposed through an anonymous in-memory file (memfd).
+//
+// Returns a path SDL_mixer can open (valid for the lifetime of the process),
+// or nullptr when no SoundFont is embedded or it could not be exposed.
+const char* EmbeddedSoundFont_GetPath();
